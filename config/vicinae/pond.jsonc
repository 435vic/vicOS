// Pond's launcher defaults, from the extra/config.jsonc of Butterfly's Vicinae
// fork (github.com/bflycomputer/vicinae, 68847f4b), applied to vanilla Vicinae.
// Imported from settings.json; anything set there overrides these values.
{
	"telemetry": {
		"system_info": false
	},
	"activate_on_single_click": true,
	"pop_to_root_on_close": true,
	"font": {
		"normal": {
			"family": "Onest",
			"size": 11.25
		}
	},
	// Pond's palettes; vicOS installs them with the launcher. "default" goes with
	// the Daylight shell theme, pond-hazel, pond-north and pond-wisteria with the
	// shell themes of the same name.
	"theme": {
		"light": { "name": "default" },
		"dark": { "name": "default" }
	},
	"launcher_window": {
		"opacity": 0.7,
		"material": "blur",
		"rounding": 24,
		"client_side_decorations": {
			"shadow_size": 64
		},
		"size": {
			"width": 638,
			"height": 590
		}
	}
}
